{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HCC groups (content/hcc_groups.json)",
  "description": "Body-system groups of the payment HCCs, used for coverage reports. Tests check that every HCC of the model appears in exactly one group.",
  "type": "object",
  "required": ["model", "groups"],
  "additionalProperties": false,
  "properties": {
    "model": {"type": "string"},
    "note": {"type": "string"},
    "groups": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["title", "hccs"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "hccs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9]+$"}}
        }
      }
    }
  }
}
