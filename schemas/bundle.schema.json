{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coding Tutor UI bundle (web/data/bundle.json)",
  "description": "The contract between the Python build step (coding_tutor.bundle.export writes it) and the static web app (web/js reads it). Both sides test against this file.",
  "type": "object",
  "required": ["version", "generated", "code_set", "tables", "codes", "hccs", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string"},
    "generated": {"type": "string"},
    "code_set": {"type": "object", "additionalProperties": {"type": "string"}},
    "tables": {"type": "object", "additionalProperties": {"$ref": "#/$defs/table"}},
    "codes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["desc", "billable"],
        "additionalProperties": false,
        "properties": {"desc": {"type": "string"}, "billable": {"type": "boolean"}}
      }
    },
    "hccs": {"type": "object", "additionalProperties": {"type": "string"}},
    "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "code": {"type": "string", "pattern": "^[A-Z][0-9][0-9A-Z](\\.[0-9A-Z]{1,4})?$"},
    "table": {
      "type": "object",
      "required": ["title", "topic", "question", "status", "slots", "confusions"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "topic": {"type": "string"},
        "question": {"type": "string"},
        "status": {"enum": ["draft", "reviewed"]},
        "slots": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["label", "values"],
            "additionalProperties": false,
            "properties": {
              "label": {"type": "string"},
              "values": {"type": "object", "additionalProperties": {"type": "string"}}
            }
          }
        },
        "confusions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["description", "lean"],
            "additionalProperties": false,
            "properties": {"description": {"type": "string"}, "lean": {"$ref": "#/$defs/lean"}}
          }
        }
      }
    },
    "lean": {"enum": ["over", "under", "neutral"]},
    "scenario": {
      "type": "object",
      "required": ["id", "table", "slots", "note", "evidence", "options", "explanations", "refs", "risk_score"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "table": {"type": "string"},
        "slots": {"type": "object", "additionalProperties": {"type": "string"}},
        "note": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start", "end", "slot"],
            "additionalProperties": false,
            "properties": {
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 1},
              "slot": {"type": "string"}
            }
          }
        },
        "options": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/option"}},
        "explanations": {"type": "array", "items": {"type": "string"}},
        "refs": {"type": "array", "items": {"type": "string"}},
        "risk_score": {"type": ["object", "null"]}
      }
    },
    "option": {
      "type": "object",
      "required": ["codes", "correct"],
      "additionalProperties": false,
      "properties": {
        "codes": {"type": "array", "items": {"$ref": "#/$defs/code"}},
        "correct": {"type": "boolean"},
        "confusion": {"type": "string"},
        "lean": {"$ref": "#/$defs/lean"},
        "why": {"type": "string"},
        "deciding": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "pivot": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["slot", "value"],
              "additionalProperties": false,
              "properties": {"slot": {"type": "string"}, "value": {"type": "string"}}
            }
          ]
        },
        "gap": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["segment", "student", "correct", "gap", "direction", "extra_hccs", "missing_hccs"],
              "properties": {
                "segment": {"type": "string"},
                "student": {"type": "number"},
                "correct": {"type": "number"},
                "gap": {"type": "number"},
                "direction": {"enum": ["over", "under", "none"]},
                "extra_hccs": {"type": "array", "items": {"type": "string"}},
                "missing_hccs": {"type": "array", "items": {"type": "string"}}
              }
            }
          ]
        }
      }
    }
  }
}
