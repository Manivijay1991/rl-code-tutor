{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Live bandit reward batch (POST /v1/events)",
  "description": "Sent by web/js/api.js, accepted by coding_tutor.live.policy. Exactly these fields: no identifiers, answers or notes. The action enum must match ACTIONS in coding_tutor.rl.simulator and web/js/bandit.js (tested).",
  "type": "object",
  "required": ["events"],
  "additionalProperties": false,
  "properties": {
    "client": {"type": "string", "maxLength": 32},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["confusion", "bucket", "action", "reward"],
        "additionalProperties": false,
        "properties": {
          "confusion": {"type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$"},
          "bucket": {"enum": [1, 2, 3]},
          "action": {"enum": ["rule_refresh", "contrast_pair", "find_meat", "guiding_question", "walkthrough", "easier_case"]},
          "reward": {"enum": [0, 1]}
        }
      }
    }
  }
}
