{
  "id": "dementia_severity",
  "title": "Dementia: type, stage and behavior",
  "status": "draft",
  "code_set": "ICD-10-CM FY2027",
  "question": "Assign the ICD-10-CM codes for the patient's cognitive disorder.",
  "note_age": {
    "min": 65
  },
  "slots": {
    "type": {
      "label": "Type of cognitive disorder",
      "values": [
        "unspecified",
        "alzheimers",
        "mci"
      ],
      "labels": {
        "unspecified": "Dementia, type not specified",
        "alzheimers": "Alzheimer's disease",
        "mci": "Mild cognitive impairment"
      },
      "evidence": {
        "unspecified": [
          "dementia"
        ],
        "alzheimers": [
          "Alzheimer's disease",
          "Alzheimer disease",
          "Alzheimer's dementia"
        ],
        "mci": [
          "mild cognitive impairment"
        ]
      },
      "exclusive": false,
      "describe": {
        "unspecified": "The provider documents dementia without naming a type or cause.",
        "alzheimers": "The provider documents Alzheimer's disease (dementia due to Alzheimer's disease).",
        "mci": "The provider documents mild cognitive impairment and states it is not dementia; never use the word dementia."
      }
    },
    "severity": {
      "label": "Documented stage",
      "values": [
        "unspecified",
        "mild",
        "moderate",
        "severe"
      ],
      "labels": {
        "unspecified": "Not documented",
        "mild": "Mild",
        "moderate": "Moderate",
        "severe": "Severe"
      },
      "evidence": {
        "unspecified": [],
        "mild": [
          "mild dementia",
          "mild Alzheimer",
          "mild stage"
        ],
        "moderate": [
          "moderate dementia",
          "moderate Alzheimer",
          "moderate stage"
        ],
        "severe": [
          "severe dementia",
          "severe Alzheimer",
          "severe stage"
        ]
      },
      "describe": {
        "unspecified": "The provider does not state a stage or severity.",
        "mild": "The provider documents the stage as mild (e.g. 'mild dementia' or 'mild Alzheimer's disease').",
        "moderate": "The provider documents the stage as moderate (e.g. 'moderate dementia' or 'moderate Alzheimer's disease').",
        "severe": "The provider documents the stage as severe (e.g. 'severe dementia' or 'severe Alzheimer's disease')."
      }
    },
    "behavior": {
      "label": "Behavioral disturbance",
      "values": [
        "none",
        "agitation"
      ],
      "labels": {
        "none": "None documented",
        "agitation": "Agitation"
      },
      "evidence": {
        "none": [],
        "agitation": [
          "agitation",
          "agitated"
        ]
      },
      "describe": {
        "none": "No behavioral, psychotic, mood or anxiety disturbance: the patient is calm and cooperative.",
        "agitation": "The provider documents agitation (for example, episodes of agitation in the evenings) and addresses it."
      }
    }
  },
  "exclude": [
    {
      "type": "mci",
      "severity": [
        "mild",
        "moderate",
        "severe"
      ]
    },
    {
      "type": "mci",
      "behavior": "agitation"
    }
  ],
  "note_forbid": [
    "vascular dementia",
    "Lewy",
    "frontotemporal",
    "Parkinson",
    "hallucination",
    "hallucinations",
    "delusion",
    "delusions",
