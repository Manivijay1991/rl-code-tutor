      "id": "etiology",
      "rules": [
        {
          "when": {
            "type": "alzheimers"
          },
          "codes": [
            "G30.9"
          ],
          "explain": "Alzheimer's disease: G30.9, sequenced first; the dementia is then coded with F02.- (dementia in other diseases classified elsewhere).",
          "refs": [
            "OCG I.A.13"
          ],
          "wrong": [
            {
              "codes": [],
              "confusion": "missed_underlying",
              "why": "F02.- is a manifestation code: code first the underlying Alzheimer's disease (G30.9)."
            }
          ]
        },
        {
          "codes": []
        }
      ]
    },
