  ],
  "note_rules": [
    {
      "when": {
        "type": "unspecified"
      },
      "forbid": [
        "Alzheimer"
      ]
    },
    {
      "when": {
        "type": "mci"
      },
      "forbid": [
        "dementia",
        "Alzheimer",
        "neurocognitive disorder"
      ]
    },
    {
      "when": {
        "type": [
          "unspecified",
          "alzheimers"
        ],
        "severity": "unspecified"
      },
      "forbid": [
        "mild",
        "moderate",
        "severe",
        "advanced",
        "early-stage",
        "late-stage",
        "end-stage"
      ]
    }
  ],
  "confusions": {
    "missed_underlying": {
      "description": "Left out the underlying condition (G30.9) that is coded first with dementia in other diseases (F02.-).",
      "lean": "under"
    },
    "wrong_dementia_category": {
      "description": "Used unspecified dementia (F03.-) when the dementia is due to Alzheimer's disease (F02.-).",
      "lean": "neutral"
    },
    "assumed_severity": {
      "description": "Coded a dementia stage the provider did not document.",
      "lean": "over"
    },
    "missed_severity": {
      "description": "Used an unspecified-severity code when the provider documented the stage.",
      "lean": "under"
    },
    "wrong_severity": {
      "description": "Coded a different stage than documented.",
      "lean": "neutral"
    },
    "missed_behavior": {
      "description": "Left out documented agitation (dementia with behavioral disturbance).",
      "lean": "under"
    },
    "unsupported_behavior": {
      "description": "Coded a behavioral disturbance that is not documented.",
      "lean": "over"
    },
    "coded_dementia_for_mci": {
      "description": "Coded dementia when the provider documented mild cognitive impairment.",
      "lean": "over"
    }
  },
  "components": [
