        "parkinsons",
        "ms_relapsing",
        "ms_unspecified"
      ],
      "labels": {
        "epilepsy": "Epilepsy, controlled",
        "epilepsy_intractable": "Intractable epilepsy",
        "seizure_disorder": "Seizure disorder",
        "single_seizure_history": "One seizure years ago, none since",
        "parkinsons": "Parkinson's disease",
        "ms_relapsing": "Relapsing-remitting MS",
        "ms_unspecified": "MS, type not stated"
      },
      "evidence": {
        "epilepsy": [
          "epilepsy"
        ],
        "epilepsy_intractable": [
          [
            "epilepsy"
