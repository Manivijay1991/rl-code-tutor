  "components": [
    {
      "id": "dx",
      "rules": [
        {
          "when": {
            "condition": "hb_sc"
          },
          "codes": [
            "D57.20"
          ],
          "explain": "Sickle cell-hemoglobin C disease without crisis: D57.20 (HCC 108).",
          "refs": [
            "ICD-10-CM Tabular: D57-D84",
            "ICD-10-CM Tabular: D57-D70"
          ],
          "wrong": [
            {
              "codes": [
                "D57.1"
              ],
              "confusion": "wrong_sickle_type",
              "why": "Hb SC is a separate sickle cell disorder (HCC 108), not Hb-SS."
            },
            {
              "codes": [
                "D57.3"
              ],
              "confusion": "wrong_sickle_type",
              "why": "It is a disease, not the trait."
            }
          ]
        },
        {
          "when": {
            "condition": "aiha_warm"
          },
          "codes": [
            "D59.11"
          ],
          "explain": "Warm autoimmune hemolytic anemia: D59.11 (HCC 109).",
          "refs": [
            "ICD-10-CM Tabular: D57-D70"
          ],
          "wrong": [
            {
              "codes": [
                "D59.9"
              ],
              "confusion": "unspecified_when_specified",
              "why": "The type (warm autoimmune) is documented."
            }
          ]
        },
        {
          "when": {
            "condition": "pancytopenia_chemo"
          },
          "codes": [
            "D61.810"
          ],
          "explain": "Antineoplastic chemotherapy-induced pancytopenia: D61.810 (no HCC in V28).",
          "refs": [
            "ICD-10-CM Tabular: D57-D70"
          ],
          "wrong": [
            {
              "codes": [
                "D61.818"
              ],
              "confusion": "drug_cause_missed",
              "why": "The chemotherapy cause is documented; D61.810 has no HCC."
            }
          ]
        },
        {
          "when": {
            "condition": "pancytopenia_other"
          },
          "codes": [
            "D61.818"
          ],
          "explain": "Pancytopenia not caused by chemotherapy: other pancytopenia, D61.818 (HCC 109).",
          "refs": [
            "ICD-10-CM Tabular: D57-D70"
          ],
          "wrong": [
            {
              "codes": [
                "D61.810"
              ],
              "confusion": "assumed_drug_cause",
              "why": "No chemotherapy cause is documented."
            }
          ]
        },
        {
          "when": {
            "condition": "hemophilia_a"
          },
          "codes": [
            "D66"
          ],
          "explain": "Hemophilia A, hereditary factor VIII deficiency: D66 (HCC 111, the 'male' hemophilia HCC).",
          "refs": [
            "ICD-10-CM Tabular: D57-D70"
          ],
          "wrong": [
            {
              "codes": [
                "D68.2"
              ],
              "confusion": "hemophilia_coded_other_factor",
              "why": "Factor VIII deficiency is hemophilia A: D66."
            },
            {
              "codes": [
                "D68.9"
              ],
              "confusion": "unspecified_when_specified",
              "why": "The factor is documented."
            }
          ]
        },
        {
          "when": {
            "condition": "cyclic_neutropenia"
          },
          "codes": [
            "D70.4"
          ],
          "explain": "Cyclic neutropenia: D70.4 (HCC 115).",
          "refs": [
            "ICD-10-CM Tabular: D57-D70"
          ],
          "wrong": [
            {
              "codes": [
                "D70.9"
              ],
              "confusion": "neutropenia_unspecified",
              "why": "The type (cyclic) is documented and carries HCC 115."
            }
          ]
        }
      ]
    }
