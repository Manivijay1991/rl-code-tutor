  "confusions": {
    "wrong_sickle_type": {
      "description": "Coded Hb-SS sickle cell disease or trait instead of the documented sickle cell variant.",
      "lean": "neutral"
    },
    "unspecified_when_specified": {
      "description": "Used an unspecified code when the specific disorder is documented.",
      "lean": "neutral"
    },
    "drug_cause_missed": {
      "description": "Coded other pancytopenia (HCC 109) for pancytopenia caused by chemotherapy (no HCC).",
      "lean": "over"
    },
    "assumed_drug_cause": {
      "description": "Coded chemotherapy-induced pancytopenia when no drug cause is documented.",
      "lean": "under"
    },
    "hemophilia_coded_other_factor": {
      "description": "Coded another clotting factor deficiency instead of hemophilia A or B.",
      "lean": "neutral"
    },
    "neutropenia_unspecified": {
      "description": "Used unspecified neutropenia when cyclic neutropenia is documented.",
      "lean": "under"
    }
