  "confusions": {
    "unspecified_when_specified": {
      "description": "Used an unspecified code when the specific disorder is documented.",
      "lean": "under"
    },
    "missed_exacerbation": {
      "description": "Coded myasthenia gravis without exacerbation when an acute exacerbation is documented.",
      "lean": "under"
    },
    "assumed_exacerbation": {
      "description": "Coded an exacerbation of myasthenia gravis that is not documented.",
      "lean": "over"
    },
    "cidp_coded_unspecified": {
      "description": "Coded unspecified polyneuropathy for CIDP.",
      "lean": "under"
    },
    "polyneuropathy_coded_cidp": {
      "description": "Coded CIDP when the provider documents only polyneuropathy.",
      "lean": "over"
    }
  },
  "components": [
    {
      "id": "nm",
      "rules": [
        {
          "when": {
            "condition": "als"
          },
          "codes": [
            "G12.21"
          ],
          "explain": "Amyotrophic lateral sclerosis: G12.21 (HCC 190).",
          "refs": [
            "ICD-10-CM Tabular: G12, G61-G62, G70-G71"
          ],
          "wrong": [
            {
              "codes": [
                "G12.20"
              ],
              "confusion": "unspecified_when_specified",
              "why": "ALS is documented, not an unspecified motor neuron disease."
            }
          ]
        },
        {
          "when": {
            "condition": "mg_exacerbation"
          },
          "codes": [
            "G70.01"
          ],
          "explain": "Myasthenia gravis with (acute) exacerbation: G70.01 (HCC 195, weight about 2.9).",
          "refs": [
            "ICD-10-CM Tabular: G12, G61-G62, G70-G71"
          ],
          "wrong": [
            {
              "codes": [
                "G70.00"
              ],
              "confusion": "missed_exacerbation",
              "why": "An acute exacerbation is documented (HCC 195, not 196)."
            }
          ]
        },
        {
          "when": {
            "condition": "mg_stable"
          },
          "codes": [
            "G70.00"
          ],
          "explain": "Myasthenia gravis without (acute) exacerbation: G70.00 (HCC 196).",
          "refs": [
            "ICD-10-CM Tabular: G12, G61-G62, G70-G71"
          ],
          "wrong": [
            {
              "codes": [
                "G70.01"
              ],
              "confusion": "assumed_exacerbation",
              "why": "No exacerbation is documented."
            }
          ]
        },
        {
          "when": {
            "condition": "becker"
          },
          "codes": [
            "G71.01"
          ],
          "explain": "Becker muscular dystrophy shares a code with Duchenne: G71.01 (HCC 197).",
          "refs": [
            "ICD-10-CM Tabular: G12, G61-G62, G70-G71"
          ],
          "wrong": [
            {
              "codes": [
                "G71.00"
              ],
              "confusion": "unspecified_when_specified",
              "why": "The type (Becker) is documented."
            }
          ]
        },
        {
          "when": {
            "condition": "cidp"
          },
          "codes": [
            "G61.81"
          ],
          "explain": "Chronic inflammatory demyelinating polyneuritis: G61.81 (HCC 193).",
          "refs": [
            "ICD-10-CM Tabular: G12, G61-G62, G70-G71"
          ],
          "wrong": [
            {
              "codes": [
                "G62.9"
              ],
              "confusion": "cidp_coded_unspecified",
              "why": "CIDP has its own code (HCC 193)."
            }
          ]
        },
        {
          "when": {
            "condition": "polyneuropathy"
          },
          "codes": [
            "G62.9"
          ],
          "explain": "Polyneuropathy without a documented cause or type: G62.9 (no HCC).",
          "refs": [
            "ICD-10-CM Tabular: G12, G61-G62, G70-G71"
          ],
          "wrong": [
            {
              "codes": [
                "G61.81"
              ],
              "confusion": "polyneuropathy_coded_cidp",
              "why": "CIDP is not documented."
            }
          ]
        }
      ]
    }
  ]
