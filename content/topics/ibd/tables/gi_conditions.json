  "components": [
    {
      "id": "gi",
      "rules": [
        {
          "when": {
            "condition": "crohns"
          },
          "codes": [
            "K50.90"
          ],
          "explain": "Crohn's disease, site not stated, no complications: K50.90 (HCC 80).",
          "refs": [
            "ICD-10-CM Tabular: K50-K86"
          ],
          "wrong": [
            {
              "codes": [
                "K50.00"
              ],
              "confusion": "assumed_site",
              "why": "The site is not documented."
            }
          ]
        },
        {
          "when": {
            "condition": "crohns_small"
          },
          "codes": [
            "K50.00"
          ],
          "explain": "Crohn's disease of the small intestine (ileum), no complications: K50.00 (HCC 80).",
          "refs": [
            "ICD-10-CM Tabular: K50-K86"
          ],
          "wrong": [
            {
              "codes": [
                "K50.90"
              ],
              "confusion": "unspecified_when_specified",
              "why": "The small intestine is documented."
            }
          ]
        },
        {
          "when": {
            "condition": "uc"
          },
          "codes": [
            "K51.90"
          ],
          "explain": "Ulcerative colitis, extent not stated, no complications: K51.90 (HCC 81).",
          "refs": [
            "ICD-10-CM Tabular: K50-K86"
          ],
          "wrong": [
            {
              "codes": [
                "K51.00"
              ],
              "confusion": "assumed_site",
              "why": "Pancolitis is not documented."
            }
          ]
        },
        {
          "when": {
            "condition": "uc_pancolitis"
          },
          "codes": [
            "K51.00"
          ],
          "explain": "Ulcerative pancolitis, no complications: K51.00 (HCC 81).",
          "refs": [
            "ICD-10-CM Tabular: K50-K86"
          ],
          "wrong": [
            {
              "codes": [
                "K51.90"
              ],
              "confusion": "unspecified_when_specified",
              "why": "The extent (pancolitis) is documented."
            }
          ]
        },
        {
          "when": {
            "condition": "ibs"
          },
          "codes": [
            "K58.9"
          ],
          "explain": "Irritable bowel syndrome: K58.9 (no HCC). It is not inflammatory bowel disease.",
          "refs": [
            "ICD-10-CM Tabular: K50-K86"
          ],
          "wrong": [
            {
              "codes": [
                "K51.90"
              ],
              "confusion": "ibs_coded_as_ibd",
              "why": "IBS is not ulcerative colitis or Crohn's disease."
            }
          ]
        },
        {
          "when": {
            "condition": "chronic_pancreatitis"
          },
          "codes": [
            "K86.1"
          ],
          "explain": "Chronic pancreatitis: K86.1 (HCC 79).",
          "refs": [
            "ICD-10-CM Tabular: K50-K86"
          ],
          "wrong": [
            {
              "codes": [
                "Z87.19"
              ],
              "confusion": "chronic_coded_acute",
              "why": "The pancreatitis is chronic and current."
            },
            {
              "codes": [
                "K85.90"
              ],
              "confusion": "chronic_coded_acute",
              "why": "Chronic pancreatitis is K86.1, not acute pancreatitis."
            }
          ]
        },
        {
          "when": {
            "condition": "acute_pancreatitis_history"
          },
          "codes": [
            "Z87.19"
          ],
          "explain": "A past acute pancreatitis that resolved: personal history, Z87.19 (no HCC).",
          "refs": [
            "OCG I.C.21.c.4"
          ],
          "wrong": [
            {
              "codes": [
                "K86.1"
              ],
              "confusion": "history_coded_chronic",
              "why": "There is no current or chronic pancreatitis."
            }
          ]
        }
      ]
    }
  ]
