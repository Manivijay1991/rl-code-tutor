  "confusions": {
    "unspecified_when_specified": {
      "description": "Used an unspecified-site code when the site or extent is documented.",
      "lean": "neutral"
    },
    "assumed_site": {
      "description": "Coded a site or extent the provider did not document.",
      "lean": "neutral"
    },
    "ibs_coded_as_ibd": {
      "description": "Coded inflammatory bowel disease when the provider documents irritable bowel syndrome.",
      "lean": "over"
    },
    "history_coded_chronic": {
      "description": "Coded chronic pancreatitis for a past acute attack that resolved.",
      "lean": "over"
    },
    "chronic_coded_acute": {
      "description": "Coded acute pancreatitis or history when chronic pancreatitis is documented.",
      "lean": "under"
    }
