  "note_rules": [
    {
      "when": {},
      "document": "Write a hospital discharge summary with sections: Admission Date, Discharge Date, Reason for Admission, Hospital Course, Discharge Diagnoses, Discharge Medications, Follow-up. It is the inpatient record of this hospital stay, not an office note.",
      "credential": "MD"
    },
    {
      "when": {
        "condition": "adhesions_partial"
      },
      "forbid": [
        "complete obstruction",
        "ileus"
      ]
    },
    {
      "when": {
        "condition": "adhesions_complete"
      },
      "forbid": [
        "partial",
        "ileus"
      ]
    },
    {
      "when": {
        "condition": "obstruction_unknown"
