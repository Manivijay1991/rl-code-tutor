  "components": [
    {
      "id": "bowel",
      "rules": [
        {
          "when": {
            "condition": "adhesions_partial"
          },
          "codes": [
            "K56.51"
          ],
          "explain": "Intestinal adhesions with partial obstruction: K56.51 (HCC 78).",
          "refs": [
            "ICD-10-CM Tabular: K56"
          ],
          "wrong": [
            {
              "codes": [
                "K56.600"
              ],
              "confusion": "missed_cause",
              "why": "The cause (adhesions) is documented."
            },
            {
              "codes": [
                "K56.52"
              ],
              "confusion": "wrong_extent",
              "why": "The obstruction is partial."
            }
          ]
        },
        {
          "when": {
            "condition": "adhesions_complete"
          },
          "codes": [
            "K56.52"
          ],
          "explain": "Intestinal adhesions with complete obstruction: K56.52 (HCC 78).",
          "refs": [
            "ICD-10-CM Tabular: K56"
          ],
          "wrong": [
            {
              "codes": [
                "K56.51"
              ],
              "confusion": "wrong_extent",
              "why": "The obstruction is complete."
            }
          ]
        },
        {
          "when": {
            "condition": "obstruction_unknown"
          },
          "codes": [
            "K56.600"
          ],
          "explain": "Partial intestinal obstruction, cause not stated: K56.600 (HCC 78).",
          "refs": [
            "ICD-10-CM Tabular: K56"
          ],
          "wrong": [
            {
              "codes": [
                "K56.51"
              ],
              "confusion": "assumed_cause",
              "why": "Adhesions are not documented."
            }
          ]
        },
        {
          "when": {
            "condition": "ileus"
          },
          "codes": [
            "K56.7"
          ],
          "explain": "Ileus without mechanical obstruction: K56.7 (HCC 78).",
          "refs": [
            "ICD-10-CM Tabular: K56"
          ],
          "wrong": [
            {
              "codes": [
                "K56.609"
              ],
