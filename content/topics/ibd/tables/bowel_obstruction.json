  "slots": {
    "condition": {
      "label": "Condition documented",
      "values": [
        "adhesions_partial",
        "adhesions_complete",
        "obstruction_unknown",
        "ileus"
      ],
      "labels": {
        "adhesions_partial": "Partial obstruction from adhesions",
        "adhesions_complete": "Complete obstruction from adhesions",
        "obstruction_unknown": "Partial obstruction, cause not found",
        "ileus": "Ileus, no mechanical obstruction"
      },
      "evidence": {
