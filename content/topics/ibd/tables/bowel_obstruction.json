        ],
        "ileus": [
          [
            "ileus"
          ]
        ]
      },
      "exclusive": false,
      "describe": {
        "adhesions_partial": "Admitted with a partial small bowel obstruction caused by adhesions from an old surgery; resolved with bowel rest and a nasogastric tube.",
        "adhesions_complete": "Admitted with a complete small bowel obstruction caused by adhesions from an old surgery; treated with surgical release of adhesions.",
        "obstruction_unknown": "Admitted with a partial small bowel obstruction; the cause was not identified and it resolved with bowel rest.",
        "ileus": "Admitted with an ileus (slowed bowel movement) without mechanical obstruction, after a medication change; resolved with supportive care."
      }
    }
