        "ileus"
      ]
    },
    {
      "when": {
        "condition": "ileus"
      },
      "forbid": [
        "adhesion",
        "mechanical obstruction was found",
        "partial obstruction",
        "complete obstruction"
      ]
    }
  ],
  "confusions": {
    "missed_cause": {
      "description": "Used unspecified obstruction when adhesions are documented as the cause.",
      "lean": "neutral"
    },
    "wrong_extent": {
      "description": "Confused partial and complete obstruction.",
      "lean": "neutral"
    },
    "assumed_cause": {
      "description": "Coded adhesions as the cause when no cause is documented.",
      "lean": "neutral"
    },
    "ileus_obstruction_confused": {
      "description": "Confused ileus with mechanical obstruction.",
      "lean": "neutral"
    }
