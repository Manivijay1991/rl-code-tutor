  "note_rules": [
    {
      "when": {
        "condition": [
          "myeloma_active",
          "myeloma_remission",
          "mds"
        ]
      },
      "forbid": [
        "lymphoma"
      ]
    },
    {
      "when": {
        "condition": "myeloma_active"
      },
      "forbid": [
        "remission",
        "myelodysplastic",
        "MDS"
      ]
    },
    {
      "when": {
        "condition": "myeloma_remission"
      },
      "forbid": [
        "not achieved remission",
        "active chemotherapy",
        "myelodysplastic",
        "MDS"
      ]
    },
