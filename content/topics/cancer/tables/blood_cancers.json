          [
            "years ago"
          ]
        ],
        "hodgkin_active": [
          [
            "Hodgkin lymphoma"
          ]
        ]
      },
      "exclusive": false,
      "describe": {
        "myeloma_active": "The oncologist documents multiple myeloma that has not achieved remission; the patient is on active chemotherapy.",
        "myeloma_remission": "The oncologist documents multiple myeloma in remission after treatment; the patient continues maintenance lenalidomide.",
        "mds": "The hematologist documents myelodysplastic syndrome with low blood counts, managed with periodic transfusions.",
        "nhl_active": "The oncologist documents non-Hodgkin lymphoma under active chemotherapy; the type and site are not stated.",
        "nhl_history": "The patient had non-Hodgkin lymphoma treated with chemotherapy years ago; treatment is complete and there is no evidence of disease.",
        "hodgkin_active": "The oncologist documents Hodgkin lymphoma under active chemotherapy; the type and site are not stated."
      }
