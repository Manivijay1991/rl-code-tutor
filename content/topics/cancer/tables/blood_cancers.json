  "confusions": {
    "assumed_remission": {
      "description": "Coded remission that is not documented.",
      "lean": "neutral"
    },
    "missed_remission": {
      "description": "Coded myeloma without remission when remission is documented.",
      "lean": "neutral"
    },
    "active_coded_history": {
      "description": "Coded personal history while the cancer is still being treated.",
      "lean": "under"
    },
    "history_coded_active": {
      "description": "Coded an active cancer after treatment is complete with no evidence of disease.",
      "lean": "over"
    },
    "symptom_for_disease": {
      "description": "Coded the anemia instead of the documented myelodysplastic syndrome.",
      "lean": "under"
    },
    "wrong_lymphoma_type": {
      "description": "Confused Hodgkin and non-Hodgkin lymphoma.",
      "lean": "neutral"
    }
  },
  "components": [
    {
      "id": "heme",
      "rules": [
        {
          "when": {
            "condition": "myeloma_active"
          },
          "codes": [
            "C90.00"
          ],
          "explain": "Multiple myeloma not having achieved remission: C90.00 (HCC 19).",
          "refs": [
            "OCG I.C.2.d",
            "ICD-10-CM Tabular: C81-C90, D46, Z85.7"
          ],
          "wrong": [
            {
              "codes": [
                "C90.01"
              ],
              "confusion": "assumed_remission",
              "why": "Remission is not documented."
            },
            {
              "codes": [
                "Z85.79"
              ],
              "confusion": "active_coded_history",
              "why": "The myeloma is under active treatment."
            }
          ]
        },
        {
          "when": {
            "condition": "myeloma_remission"
          },
          "codes": [
            "C90.01"
          ],
          "explain": "Multiple myeloma in remission: C90.01 (HCC 19). It is not a history code.",
          "refs": [
            "ICD-10-CM Tabular: C81-C90, D46, Z85.7"
          ],
          "wrong": [
            {
              "codes": [
                "C90.00"
              ],
              "confusion": "missed_remission",
              "why": "Remission is documented."
            },
            {
              "codes": [
                "Z85.79"
              ],
              "confusion": "active_coded_history",
              "why": "Myeloma in remission is coded with the remission code, not history."
            }
          ]
        },
        {
          "when": {
            "condition": "mds"
          },
          "codes": [
            "D46.9"
          ],
          "explain": "Myelodysplastic syndrome, unspecified: D46.9 (HCC 19).",
          "refs": [
            "ICD-10-CM Tabular: C81-C90, D46, Z85.7"
          ],
          "wrong": [
            {
              "codes": [
                "D64.9"
              ],
              "confusion": "symptom_for_disease",
              "why": "The cause of the low counts (MDS) is documented."
            }
          ]
        },
        {
          "when": {
            "condition": "nhl_active"
          },
          "codes": [
            "C85.90"
          ],
          "explain": "Non-Hodgkin lymphoma under treatment, type and site not stated: C85.90 (HCC 21).",
          "refs": [
            "OCG I.C.2.d",
            "ICD-10-CM Tabular: C81-C90, D46, Z85.7"
          ],
          "wrong": [
            {
              "codes": [
                "Z85.72"
              ],
              "confusion": "active_coded_history",
              "why": "The lymphoma is under active treatment."
            }
          ]
        },
        {
          "when": {
            "condition": "nhl_history"
          },
          "codes": [
            "Z85.72"
          ],
          "explain": "Lymphoma treated in the past with no current disease or treatment: personal history, Z85.72 (no HCC).",
          "refs": [
            "OCG I.C.2.d",
            "ICD-10-CM Tabular: C81-C90, D46, Z85.7"
          ],
          "wrong": [
            {
              "codes": [
                "C85.90"
              ],
              "confusion": "history_coded_active",
              "why": "Treatment is complete and there is no evidence of disease."
            }
          ]
        },
        {
          "when": {
            "condition": "hodgkin_active"
          },
          "codes": [
            "C81.90"
          ],
          "explain": "Hodgkin lymphoma under treatment, type and site not stated: C81.90 (HCC 21).",
          "refs": [
            "ICD-10-CM Tabular: C81-C90, D46, Z85.7"
          ],
          "wrong": [
            {
              "codes": [
                "C85.90"
              ],
              "confusion": "wrong_lymphoma_type",
              "why": "Hodgkin lymphoma is documented, not non-Hodgkin."
            }
          ]
        }
      ]
    }
  ]
}
