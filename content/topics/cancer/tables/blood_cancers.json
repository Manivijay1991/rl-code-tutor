        "myeloma_active",
        "myeloma_remission",
        "mds",
        "nhl_active",
        "nhl_history",
        "hodgkin_active"
      ],
      "labels": {
        "myeloma_active": "Multiple myeloma, on treatment, not in remission",
        "myeloma_remission": "Multiple myeloma in remission",
        "mds": "Myelodysplastic syndrome",
        "nhl_active": "Non-Hodgkin lymphoma, under treatment",
        "nhl_history": "Non-Hodgkin lymphoma treated years ago, no disease",
        "hodgkin_active": "Hodgkin lymphoma, under treatment"
      },
      "evidence": {
        "myeloma_active": [
          [
            "multiple myeloma"
          ]
        ],
        "myeloma_remission": [
          [
            "multiple myeloma"
          ],
          [
            "in remission",
