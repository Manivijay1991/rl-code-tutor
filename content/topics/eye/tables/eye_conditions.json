  "note_rules": [
    {
      "when": {
        "condition": [
          "wet_amd_active",
          "wet_amd_scar",
          "dry_amd_early"
        ]
      },
      "forbid": [
        "diabetes",
        "diabetic",
        "retinopathy"
      ]
    },
    {
      "when": {
        "condition": "wet_amd_active"
      },
      "forbid": [
        "dry",
        "nonexudative",
        "scar",
        "inactive"
      ]
    },
    {
      "when": {
        "condition": "wet_amd_scar"
      },
      "forbid": [
        "dry",
        "nonexudative",
        "active choroidal",
        "anti-VEGF injection today"
      ]
    },
    {
      "when": {
        "condition": "dry_amd_early"
      },
      "forbid": [
        "wet",
        "exudative",
        "neovascular",
        "intermediate",
        "advanced"
      ]
    },
    {
      "when": {
        "condition": [
          "pdr",
          "npdr_mild"
        ]
      },
      "forbid": [
        "macular degeneration",
        "AMD"
      ]
    },
    {
      "when": {
        "condition": "pdr"
      },
      "forbid": [
        "nonproliferative",
        "NPDR",
        "stable proliferative"
      ]
