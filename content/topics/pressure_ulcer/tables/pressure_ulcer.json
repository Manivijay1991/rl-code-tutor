          "unstageable"
        ],
        "unspecified": [],
        "healed": [
          "completely healed",
          "fully healed",
          "has healed"
        ]
      },
      "describe": {
        "2": "The provider documents a stage 2 pressure ulcer and treats it.",
        "3": "The provider documents a stage 3 pressure ulcer and treats it.",
        "4": "The provider documents a stage 4 pressure ulcer and treats it.",
        "unstageable": "The provider documents the pressure ulcer as unstageable because the wound base is covered by eschar, and treats it.",
        "unspecified": "The provider documents a pressure ulcer and treats it, but states no stage and does not describe its depth.",
