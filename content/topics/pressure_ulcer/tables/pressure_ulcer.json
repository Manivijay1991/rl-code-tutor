  "confusions": {
    "unspecified_when_documented": {
      "description": "Used the unspecified-stage code when the stage (or unstageable) is documented.",
      "lean": "under"
    },
    "understated_stage": {
      "description": "Coded a lower stage than documented.",
      "lean": "under"
    },
    "overstated_stage": {
      "description": "Coded a higher stage than documented.",
      "lean": "over"
    },
    "assumed_stage": {
      "description": "Coded a stage the provider did not document.",
      "lean": "over"
    },
    "healed_coded": {
      "description": "Coded a pressure ulcer that is completely healed.",
      "lean": "over"
    }
  },
