              "confusion": "missed_specific_pneumonia",
              "why": "Aspiration pneumonia has its own code (HCC 282)."
            }
          ]
        },
        {
          "when": {
            "condition": "mrsa"
          },
          "codes": [
            "J15.212"
          ],
          "explain": "Pneumonia due to MRSA: J15.212 (HCC 282).",
