{
  "id": "fibrosis_airway",
  "title": "Pulmonary fibrosis, scleroderma lung, tracheostomy and ventilator",
  "status": "draft",
  "code_set": "ICD-10-CM FY2027",
  "question": "Assign the ICD-10-CM codes for the patient's lung fibrosis or airway status.",
  "note_age": {
    "min": 50,
    "max": 85
  },
  "slots": {
    "condition": {
      "label": "Condition documented",
      "values": [
        "ipf",
        "pf_unspecified",
        "ssc_lung",
        "trach_vent",
        "trach_only"
      ],
      "labels": {
        "ipf": "Idiopathic pulmonary fibrosis",
        "pf_unspecified": "Pulmonary fibrosis, cause not stated",
        "ssc_lung": "Systemic sclerosis with lung involvement",
        "trach_vent": "Tracheostomy and home ventilator",
        "trach_only": "Tracheostomy, breathing on own"
      },
      "evidence": {
        "ipf": [
          [
            "idiopathic pulmonary fibrosis",
            "IPF"
          ]
        ],
        "pf_unspecified": [
          [
            "pulmonary fibrosis"
          ]
        ],
        "ssc_lung": [
          [
            "systemic sclerosis",
            "scleroderma"
          ],
          [
            "interstitial lung disease",
            "lung involvement"
          ]
        ],
        "trach_vent": [
          [
            "tracheostomy"
          ],
          [
            "ventilator"
          ]
        ],
        "trach_only": [
          [
            "tracheostomy"
          ]
        ]
      },
      "exclusive": false,
      "describe": {
        "ipf": "The pulmonologist documents idiopathic pulmonary fibrosis (IPF), on an antifibrotic drug, with stable lung function tests.",
        "pf_unspecified": "The provider documents pulmonary fibrosis seen on CT; the cause is not determined and a pulmonology referral is placed.",
        "ssc_lung": "The rheumatologist documents systemic sclerosis (scleroderma) with lung involvement (interstitial lung disease), on mycophenolate.",
        "trach_vent": "The patient has a tracheostomy and depends on a home ventilator at night and part of the day after a past illness; trach care is reviewed.",
        "trach_only": "The patient has a long-standing tracheostomy and breathes without a ventilator; stoma care and supplies are reviewed."
      }
    }
  },
  "note_forbid": [
    "COPD",
    "chronic obstructive",
    "emphysema",
    "chronic bronchitis",
    "lung cancer",
    "heart failure",
    "COVID",
    "asthma",
    "cystic fibrosis",
    "pneumonia",
    "respiratory failure",
    "cancer",
    "ALS",
    "amyotrophic",
    "spinal cord",
    "quadriplegia",
    "stroke",
    "rheumatoid",
    "lupus",
    "sarcoid",
    "Raynaud"
  ],
  "note_rules": [
    {
      "when": {
        "condition": [
          "ipf",
          "pf_unspecified",
          "ssc_lung"
        ]
      },
      "forbid": [
        "tracheostomy",
        "ventilator",
        "trach"
      ]
    },
    {
      "when": {
        "condition": "ipf"
      },
      "forbid": [
        "scleroderma",
        "systemic sclerosis",
        "cause is not",
        "unknown cause"
      ]
    },
    {
      "when": {
        "condition": "pf_unspecified"
      },
      "forbid": [
        "idiopathic",
        "IPF",
        "scleroderma",
        "systemic sclerosis",
        "antifibrotic"
      ]
    },
    {
      "when": {
        "condition": "ssc_lung"
      },
      "forbid": [
        "idiopathic",
        "IPF"
      ]
    },
    {
      "when": {
        "condition": [
          "trach_vent",
          "trach_only"
        ]
      },
      "forbid": [
        "fibrosis",
        "scleroderma",
        "systemic sclerosis",
        "decannulat"
      ]
    },
    {
      "when": {
        "condition": "trach_only"
      },
      "forbid": [
        "ventilator dependent",
        "ventilator-dependent",
        "on the ventilator",
        "BiPAP",
        "CPAP"
      ]
    }
  ],
  "confusions": {
    "understated_fibrosis": {
      "description": "Coded unspecified pulmonary fibrosis when idiopathic pulmonary fibrosis is documented.",
      "lean": "under"
    },
    "assumed_idiopathic": {
      "description": "Coded idiopathic pulmonary fibrosis when the cause is not documented.",
      "lean": "over"
    },
    "missed_combination": {
      "description": "Coded systemic sclerosis and lung fibrosis separately instead of the combination code M34.81.",
      "lean": "neutral"
    },
    "missed_vent_status": {
      "description": "Coded the tracheostomy but missed the ventilator dependence.",
      "lean": "neutral"
    },
    "missed_trach_status": {
      "description": "Left out the tracheostomy status (HCC 211).",
      "lean": "under"
    }
  },
  "components": [
    {
      "id": "dx",
      "rules": [
        {
          "when": {
            "condition": "ipf"
          },
          "codes": [
            "J84.112"
          ],
          "explain": "Idiopathic pulmonary fibrosis: J84.112 (HCC 278).",
          "refs": [
            "ICD-10-CM Tabular: J84, M34, Z93, Z99"
          ],
          "wrong": [
            {
              "codes": [
                "J84.10"
              ],
              "confusion": "understated_fibrosis",
              "why": "IPF is documented (HCC 278, not 280)."
            }
          ]
        },
        {
          "when": {
            "condition": "pf_unspecified"
          },
          "codes": [
            "J84.10"
          ],
          "explain": "Pulmonary fibrosis without a documented cause: J84.10 (HCC 280).",
          "refs": [
            "ICD-10-CM Tabular: J84, M34, Z93, Z99"
          ],
          "wrong": [
            {
              "codes": [
                "J84.112"
              ],
              "confusion": "assumed_idiopathic",
              "why": "Idiopathic is not documented."
            }
          ]
        },
        {
          "when": {
            "condition": "ssc_lung"
          },
          "codes": [
            "M34.81"
          ],
          "explain": "Systemic sclerosis with lung involvement has a combination code: M34.81, which maps to two HCCs (93 and 278).",
          "refs": [
            "ICD-10-CM Tabular: J84, M34, Z93, Z99"
          ],
          "wrong": [
            {
              "codes": [
                "M34.9",
                "J84.10"
              ],
              "confusion": "missed_combination",
              "why": "Use the combination code M34.81."
            }
          ]
        },
        {
          "when": {
            "condition": "trach_vent"
          },
          "codes": [
            "Z93.0",
            "Z99.11"
          ],
          "explain": "Tracheostomy status, Z93.0, plus dependence on a ventilator, Z99.11 (both HCC 211).",
          "refs": [
            "ICD-10-CM Tabular: J84, M34, Z93, Z99"
          ],
          "wrong": [
            {
              "codes": [
                "Z93.0"
              ],
              "confusion": "missed_vent_status",
              "why": "Ventilator dependence is documented: add Z99.11."
            }
          ]
        },
        {
          "when": {
            "condition": "trach_only"
          },
          "codes": [
            "Z93.0"
          ],
          "explain": "Tracheostomy status without ventilator dependence: Z93.0 (HCC 211).",
          "refs": [
            "ICD-10-CM Tabular: J84, M34, Z93, Z99"
          ],
          "wrong": [
            {
              "codes": [],
              "confusion": "missed_trach_status",
              "why": "Tracheostomy status is reportable (HCC 211)."
            },
            {
              "codes": [
                "Z93.0",
                "Z99.11"
              ],
              "confusion": "missed_vent_status",
              "why": "No ventilator dependence is documented."
            }
          ]
        }
      ]
    }
  ]
}
