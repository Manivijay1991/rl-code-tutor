  "confusions": {
    "unspecified_when_specified": {
      "description": "Used an unspecified code when the specific disorder or type is documented.",
      "lean": "neutral"
    },
    "assumed_type": {
      "description": "Coded a specific type the provider did not document.",
      "lean": "neutral"
    },
    "understated_adrenal": {
      "description": "Coded unspecified adrenal insufficiency (no HCC) for documented Addison's disease (HCC 51).",
      "lean": "under"
    },
    "overstated_adrenal": {
      "description": "Coded Addison's disease when only adrenal insufficiency is documented.",
      "lean": "over"
    },
    "drug_cushing_coded_disease": {
      "description": "Coded pituitary Cushing's disease (HCC 51) for drug-induced Cushing's syndrome (no HCC).",
      "lean": "over"
    }
