  "components": [
    {
      "id": "endo",
      "rules": [
        {
          "when": {
            "condition": "gaucher"
          },
          "codes": [
            "E75.22"
          ],
          "explain": "Gaucher disease: E75.22 (HCC 49, one of the highest V28 weights).",
          "refs": [
            "ICD-10-CM Tabular: E22-E27, E75, E85"
          ],
          "wrong": [
            {
              "codes": [
                "E88.9"
              ],
              "confusion": "unspecified_when_specified",
              "why": "The specific storage disorder is documented."
            }
          ]
        },
        {
          "when": {
            "condition": "fabry"
          },
          "codes": [
            "E75.21"
          ],
          "explain": "Fabry (-Anderson) disease: E75.21 (HCC 49).",
          "refs": [
            "ICD-10-CM Tabular: E22-E27, E75, E85"
          ],
          "wrong": [
            {
              "codes": [
                "E88.9"
              ],
              "confusion": "unspecified_when_specified",
              "why": "The specific storage disorder is documented."
            }
          ]
        },
        {
          "when": {
            "condition": "attr"
          },
          "codes": [
            "E85.82"
          ],
          "explain": "Wild-type transthyretin-related amyloidosis: E85.82 (HCC 50).",
          "refs": [
            "ICD-10-CM Tabular: E22-E27, E75, E85"
          ],
          "wrong": [
            {
              "codes": [
                "E85.9"
              ],
              "confusion": "unspecified_when_specified",
              "why": "The type (wild-type ATTR) is documented."
            }
          ]
        },
        {
          "when": {
            "condition": "amyloid_unspecified"
          },
          "codes": [
            "E85.9"
          ],
          "explain": "Amyloidosis without a documented type: E85.9 (HCC 50).",
          "refs": [
            "ICD-10-CM Tabular: E22-E27, E75, E85"
          ],
          "wrong": [
            {
              "codes": [
                "E85.82"
              ],
              "confusion": "assumed_type",
              "why": "The type is not documented."
            }
          ]
        },
        {
          "when": {
            "condition": "addison"
          },
          "codes": [
            "E27.1"
          ],
          "explain": "Addison's disease = primary adrenocortical insufficiency: E27.1 (HCC 51).",
          "refs": [
            "ICD-10-CM Tabular: E22-E27, E75, E85"
          ],
          "wrong": [
            {
              "codes": [
                "E27.40"
              ],
              "confusion": "understated_adrenal",
              "why": "Primary (Addison's) is documented; unspecified has no HCC."
            }
          ]
        },
        {
          "when": {
            "condition": "adrenal_unspecified"
          },
          "codes": [
            "E27.40"
          ],
          "explain": "Adrenal insufficiency, type not stated: E27.40 (no HCC in V28).",
          "refs": [
            "ICD-10-CM Tabular: E22-E27, E75, E85"
          ],
          "wrong": [
            {
              "codes": [
                "E27.1"
              ],
              "confusion": "overstated_adrenal",
              "why": "Primary (Addison's) is not documented."
            }
          ]
        },
        {
          "when": {
            "condition": "acromegaly"
          },
          "codes": [
            "E22.0"
          ],
          "explain": "Acromegaly: E22.0 (HCC 51).",
          "refs": [
            "ICD-10-CM Tabular: E22-E27, E75, E85"
          ],
          "wrong": [
            {
              "codes": [
                "E23.7"
              ],
              "confusion": "unspecified_when_specified",
              "why": "Acromegaly has its own code."
            }
          ]
        },
        {
          "when": {
            "condition": "cushing_drug"
          },
          "codes": [
            "E24.2"
          ],
          "explain": "Drug-induced Cushing's syndrome: E24.2 (no HCC).",
          "refs": [
            "ICD-10-CM Tabular: E22-E27, E75, E85"
          ],
          "wrong": [
            {
              "codes": [
                "E24.0"
              ],
              "confusion": "drug_cushing_coded_disease",
              "why": "It is caused by steroid medication, not the pituitary."
