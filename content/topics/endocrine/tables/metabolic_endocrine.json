      "describe": {
        "gaucher": "The geneticist documents Gaucher disease, on enzyme replacement therapy every two weeks.",
        "fabry": "The provider documents Fabry disease, on enzyme replacement therapy, with burning pain in the hands and feet.",
        "attr": "The cardiologist documents wild-type transthyretin (ATTR) amyloidosis, on tafamidis.",
        "amyloid_unspecified": "The provider documents amyloidosis found on a biopsy; the type is not yet determined and a hematology referral is placed.",
        "addison": "The endocrinologist documents Addison's disease (primary adrenal insufficiency), on hydrocortisone and fludrocortisone.",
        "adrenal_unspecified": "The provider documents adrenal insufficiency on hydrocortisone; whether it is primary or secondary is not stated.",
        "acromegaly": "The endocrinologist documents acromegaly from a pituitary adenoma, on octreotide.",
        "cushing_drug": "The provider documents Cushing's syndrome caused by long-term prednisone for a lung condition; a slow taper is planned."
      }
