            "ICD-10-CM Tabular: F32-F33"
          ],
          "wrong": [
            {
              "codes": [
                "F32.0"
              ],
              "confusion": "severity_down",
              "why": "The provider documents moderate (HCC 155); mild has no HCC."
            },
            {
              "codes": [
                "F32.9"
              ],
              "confusion": "unspecified_when_specified",
              "why": "Severity is documented: do not use the unspecified code."
            }
          ]
        },
        {
