{
  "id": "depression_severity",
  "title": "Major depression: episode, severity and remission",
  "status": "draft",
  "code_set": "ICD-10-CM FY2027",
  "question": "Assign the ICD-10-CM code for the patient's depressive disorder.",
  "slots": {
    "episode": {
      "label": "Diagnosis documented",
      "values": [
        "single",
        "recurrent",
        "unspecified_depression"
      ],
      "labels": {
        "single": "Major depression, single episode",
        "recurrent": "Major depression, recurrent",
        "unspecified_depression": "'Depression' only"
      },
      "evidence": {
        "single": [
          "single episode"
        ],
        "recurrent": [
          "recurrent"
        ],
        "unspecified_depression": [
          "depression"
        ]
      },
      "exclusive": false,
      "describe": {
        "single": "The provider documents major depressive disorder, single episode.",
        "recurrent": "The provider documents major depressive disorder, recurrent.",
        "unspecified_depression": "The provider documents only 'depression', without calling it major depressive disorder and without an episode or severity."
      }
    },
    "status": {
      "label": "Current severity or remission",
      "values": [
        "mild",
        "moderate",
        "severe",
        "severe_psychotic",
        "partial_remission",
        "full_remission",
        "unspecified"
      ],
      "labels": {
        "mild": "Mild",
        "moderate": "Moderate",
        "severe": "Severe, no psychotic features",
        "severe_psychotic": "Severe with psychotic features",
        "partial_remission": "In partial remission",
        "full_remission": "In full remission",
        "unspecified": "Not documented"
      },
      "evidence": {
        "mild": [
          "mild"
        ],
        "moderate": [
          "moderate"
        ],
        "severe": [
          [
            "severe"
          ],
          [
            "without psychotic features"
          ]
        ],
        "severe_psychotic": [
          [
            "severe"
          ],
          [
            "with psychotic features"
          ]
        ],
        "partial_remission": [
          "partial remission"
        ],
        "full_remission": [
          "full remission"
        ],
        "unspecified": []
      },
      "describe": {
        "mild": "The current episode is documented as mild.",
        "moderate": "The current episode is documented as moderate.",
        "severe": "The current episode is documented as severe without psychotic features.",
        "severe_psychotic": "The current episode is documented as severe with psychotic features (e.g. mood-congruent delusions), and the provider addresses them.",
        "partial_remission": "The provider documents the depression as in partial remission.",
        "full_remission": "The provider documents the depression as in full remission.",
        "unspecified": "The provider does not state a severity or remission status."
      }
    }
  },
  "exclude": [
    {
      "episode": "unspecified_depression",
      "status": [
        "mild",
        "moderate",
        "severe",
        "severe_psychotic",
        "partial_remission",
        "full_remission"
      ]
    }
  ],
  "note_forbid": [
    "bipolar",
    "manic",
    "mania",
    "hypomanic",
    "schizophrenia",
    "schizoaffective",
    "dysthymia",
    "dysthymic",
    "postpartum",
    "seasonal pattern",
    "suicidal",
    "anxiety disorder",
    "PTSD",
    "substance",
    "alcohol use disorder"
  ],
  "note_rules": [
    {
      "when": {
        "episode": "unspecified_depression"
      },
      "forbid": [
        "major depressive",
        "MDD",
        "recurrent",
        "single episode",
        "episode"
      ]
    },
    {
      "when": {
        "episode": [
          "single",
          "recurrent"
        ]
      },
      "require": [
        [
          "major depressive disorder",
          "MDD"
        ]
      ]
    },
    {
      "when": {
        "status": [
          "mild",
          "moderate",
          "severe",
          "severe_psychotic",
          "unspecified"
        ]
      },
      "forbid": [
        "remission"
      ]
    },
    {
      "when": {
        "status": [
          "mild",
          "moderate",
          "partial_remission",
          "full_remission",
          "unspecified"
        ]
      },
      "forbid": [
        "psychotic",
        "hallucination",
        "hallucinations",
        "delusion",
        "delusions"
      ]
    },
    {
      "when": {
        "status": "severe"
      },
      "forbid": [
        "hallucination",
        "hallucinations",
        "delusion",
        "delusions"
      ]
    }
  ],
  "confusions": {
    "severity_up": {
      "description": "Coded a higher severity than documented.",
      "lean": "over"
    },
    "severity_down": {
      "description": "Coded a lower severity than documented.",
      "lean": "under"
    },
    "unspecified_when_specified": {
      "description": "Used the unspecified code when the severity is documented.",
      "lean": "under"
    },
    "assumed_severity": {
      "description": "Coded a severity the provider did not document.",
      "lean": "over"
    },
    "unsupported_psychotic": {
      "description": "Coded psychotic features that are not documented.",
      "lean": "over"
    },
    "missed_psychotic": {
      "description": "Left out documented psychotic features.",
      "lean": "under"
    },
    "remission_coded_active": {
      "description": "Coded an active severity when the provider documented remission.",
      "lean": "over"
    },
    "wrong_remission": {
      "description": "Confused partial and full remission.",
      "lean": "neutral"
    },
    "single_vs_recurrent": {
      "description": "Confused a single episode with recurrent depression.",
      "lean": "neutral"
    },
    "coded_mdd_without_documentation": {
      "description": "Coded major depressive disorder when only 'depression' is documented.",
      "lean": "over"
    }
  },
  "components": [
    {
      "id": "dx",
      "rules": [
        {
          "when": {
            "episode": "single",
            "status": "mild"
          },
          "codes": [
            "F32.0"
          ],
          "explain": "Major depressive disorder, single episode, mild (no HCC in V28): F32.0.",
          "refs": [
            "ICD-10-CM Tabular: F32-F33"
          ],
          "wrong": [
            {
              "codes": [
                "F32.1"
              ],
              "confusion": "severity_up",
              "why": "The provider documents mild; moderate maps to an HCC that mild does not."
            },
            {
              "codes": [
                "F33.0"
              ],
              "confusion": "single_vs_recurrent",
              "why": "The provider documents single episode."
            }
          ]
        },
        {
          "when": {
            "episode": "single",
            "status": "moderate"
          },
          "codes": [
            "F32.1"
          ],
          "explain": "Major depressive disorder, single episode, moderate (HCC 155): F32.1.",
