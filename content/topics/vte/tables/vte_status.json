  "confusions": {
    "acute_coded_history": {
      "description": "Coded history of a clot while the acute clot is still being treated.",
      "lean": "under"
    },
    "history_coded_active": {
      "description": "Coded an active clot after treatment was completed and it resolved.",
      "lean": "over"
    },
    "acute_chronic_confused": {
      "description": "Confused acute and chronic thrombosis or embolism.",
      "lean": "neutral"
    },
    "chronic_coded_history": {
      "description": "Coded history when chronic thrombosis or embolism is documented.",
      "lean": "under"
    }
