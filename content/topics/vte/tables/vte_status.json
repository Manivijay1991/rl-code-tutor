  "components": [
    {
      "id": "vte",
      "rules": [
        {
          "when": {
            "condition": "acute_dvt"
          },
          "codes": [
            "I82.411"
          ],
          "explain": "Acute DVT of the right femoral vein, still under initial treatment: I82.411 (HCC 267).",
          "refs": [
            "ICD-10-CM Tabular: I26-I27, I82, Z86.7"
          ],
          "wrong": [
            {
              "codes": [
                "Z86.718"
              ],
              "confusion": "acute_coded_history",
              "why": "The clot is acute and still being treated."
            },
            {
              "codes": [
                "I82.511"
              ],
              "confusion": "acute_chronic_confused",
              "why": "The DVT is documented as acute."
            }
          ]
        },
        {
          "when": {
            "condition": "chronic_dvt"
          },
          "codes": [
            "I82.511"
          ],
          "explain": "Chronic DVT of the right femoral vein: I82.511 (HCC 267).",
          "refs": [
            "ICD-10-CM Tabular: I26-I27, I82, Z86.7"
          ],
          "wrong": [
            {
              "codes": [
                "I82.411"
              ],
              "confusion": "acute_chronic_confused",
              "why": "The DVT is documented as chronic."
            },
            {
              "codes": [
                "Z86.718"
              ],
              "confusion": "chronic_coded_history",
              "why": "Chronic DVT is a current condition, not history."
            }
          ]
        },
        {
          "when": {
            "condition": "dvt_history"
          },
          "codes": [
            "Z86.718"
          ],
          "explain": "A DVT that resolved after completed treatment: personal history, Z86.718 (no HCC).",
          "refs": [
            "OCG I.C.21.c.4",
            "ICD-10-CM Tabular: I26-I27, I82, Z86.7"
          ],
          "wrong": [
            {
              "codes": [
                "I82.401"
              ],
              "confusion": "history_coded_active",
              "why": "There is no current clot: code the history."
            }
          ]
        },
        {
          "when": {
            "condition": "acute_pe"
          },
          "codes": [
            "I26.99"
          ],
          "explain": "Acute pulmonary embolism without acute cor pulmonale, under initial treatment: I26.99 (HCC 267).",
          "refs": [
            "ICD-10-CM Tabular: I26-I27, I82, Z86.7"
          ],
          "wrong": [
            {
              "codes": [
                "Z86.711"
              ],
              "confusion": "acute_coded_history",
              "why": "The embolism is acute and still being treated."
            },
            {
              "codes": [
                "I27.82"
              ],
              "confusion": "acute_chronic_confused",
              "why": "The embolism is documented as acute."
            }
          ]
        },
        {
          "when": {
            "condition": "chronic_pe"
          },
          "codes": [
            "I27.82"
          ],
          "explain": "Chronic pulmonary embolism: I27.82 (HCC 267).",
          "refs": [
            "ICD-10-CM Tabular: I26-I27, I82, Z86.7"
          ],
          "wrong": [
            {
              "codes": [
                "I26.99"
              ],
              "confusion": "acute_chronic_confused",
              "why": "The embolism is documented as chronic."
            },
            {
              "codes": [
                "Z86.711"
              ],
              "confusion": "chronic_coded_history",
              "why": "Chronic embolism is a current condition, not history."
            }
          ]
        },
        {
          "when": {
            "condition": "pe_history"
          },
          "codes": [
            "Z86.711"
          ],
          "explain": "A pulmonary embolism that resolved after completed treatment: personal history, Z86.711 (no HCC).",
          "refs": [
            "OCG I.C.21.c.4",
            "ICD-10-CM Tabular: I26-I27, I82, Z86.7"
          ],
          "wrong": [
            {
              "codes": [
                "I26.99"
              ],
              "confusion": "history_coded_active",
              "why": "There is no current embolism: code the history."
            }
          ]
        }
      ]
