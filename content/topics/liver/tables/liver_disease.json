          "chronic hepatitis C"
        ],
        "hep_c_cured": [
          "sustained virologic response",
          "SVR"
        ],
        "fatty_liver": [
          "fatty liver",
          "hepatic steatosis"
        ]
      },
      "exclusive": false,
      "describe": {
        "cirrhosis": "The provider documents cirrhosis of the liver; the cause is not stated.",
        "alcoholic_cirrhosis": "The provider documents alcoholic cirrhosis without ascites; the patient no longer drinks.",
        "alcoholic_cirrhosis_ascites": "The provider documents alcoholic cirrhosis with ascites; the patient no longer drinks.",
        "hep_c_chronic": "The provider documents chronic hepatitis C, being monitored; not yet treated.",
        "hep_c_cured": "Hepatitis C was cured with antiviral treatment years ago (sustained virologic response); there is no current infection and no liver damage.",
        "fatty_liver": "The provider documents fatty liver (hepatic steatosis) on ultrasound, managed with diet and exercise."
