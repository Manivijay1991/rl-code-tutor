  "note_age": {
    "min": 35
  },
  "slots": {
    "condition": {
      "label": "Condition documented",
      "values": [
        "cirrhosis",
        "alcoholic_cirrhosis",
        "alcoholic_cirrhosis_ascites",
        "hep_c_chronic",
        "hep_c_cured",
        "fatty_liver"
      ],
      "labels": {
        "cirrhosis": "Cirrhosis, cause not stated",
        "alcoholic_cirrhosis": "Alcoholic cirrhosis",
        "alcoholic_cirrhosis_ascites": "Alcoholic cirrhosis with ascites",
        "hep_c_chronic": "Chronic hepatitis C",
        "hep_c_cured": "Hepatitis C cured (SVR)",
        "fatty_liver": "Fatty liver"
      },
      "evidence": {
        "cirrhosis": [
          "cirrhosis"
        ],
        "alcoholic_cirrhosis": [
          "alcoholic cirrhosis"
        ],
        "alcoholic_cirrhosis_ascites": [
          [
            "alcoholic cirrhosis"
          ],
          [
