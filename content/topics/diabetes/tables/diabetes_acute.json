      "description": "Coded diabetes with hyperglycemia for ketoacidosis or a hyperosmolar state (HCC 38 instead of 36).",
      "lean": "under"
    },
    "hyperglycemia_coded_dka": {
      "description": "Coded ketoacidosis or a hyperosmolar state when only hyperglycemia is documented.",
      "lean": "over"
    },
    "wrong_dm_type": {
      "description": "Coded the wrong type of diabetes.",
      "lean": "neutral"
    },
    "missed_coma": {
