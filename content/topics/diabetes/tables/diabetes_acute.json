      "describe": {
        "t2_dka": "Admitted with diabetic ketoacidosis (DKA) in type 2 diabetes, without coma; treated with an insulin drip and fluids.",
        "t1_dka": "Admitted with diabetic ketoacidosis (DKA) in type 1 diabetes, without coma, after missed insulin doses; treated with an insulin drip and fluids.",
        "t2_hhs": "Admitted with hyperglycemic hyperosmolar state in type 2 diabetes, without coma; treated with fluids and insulin.",
        "t2_hypo_coma": "Admitted unresponsive in a hypoglycemic coma from a sulfonylurea in type 2 diabetes; recovered with IV dextrose.",
        "t2_hyperglycemia": "Admitted with hyperglycemia (blood glucose over 400) in type 2 diabetes; no ketoacidosis and no hyperosmolar state; insulin adjusted."
