{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coding Tutor decision table",
  "description": "Slots (deciding details) -> codes. Each component has an ordered rule list; the first matching rule wins; the answer is the union across components. Structural checks live in engine/rules_engine.py.",
  "type": "object",
  "required": ["id", "status", "slots", "confusions", "components"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "title": {"type": "string"},
    "topic": {"type": "string"},
    "status": {"enum": ["draft", "reviewed"]},
    "code_set": {"type": "string"},
    "note": {"type": "string"},
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["values"],
        "properties": {
          "values": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "evidence": {"type": "object", "description": "value -> phrases a generated note must contain (any one) so the deciding detail is present",
                       "additionalProperties": {"type": "array", "items": {"type": "string"}}}
        }
      }
    },
    "exclude": {"type": "array", "description": "Partial slot assignments that are unrealistic; values may be strings or lists",
                "items": {"type": "object"}},
    "confusions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "lean"],
        "properties": {"description": {"type": "string"}, "lean": {"enum": ["over", "under", "neutral"]}}
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rules"],
        "properties": {
          "id": {"type": "string"},
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["codes"],
              "properties": {
                "when": {"type": "object", "description": "slot -> value or [values]; omitted slots match anything"},
                "codes": {"type": "array", "items": {"type": "string"}},
                "explain": {"type": "string"},
                "refs": {"type": "array", "items": {"type": "string"}},
                "wrong": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["codes", "confusion"],
                    "properties": {
                      "codes": {"type": "array", "items": {"type": "string"}, "description": "replaces this component's codes"},
                      "also": {"type": "array", "items": {"type": "string"}, "description": "extra codes added to the distractor"},
                      "confusion": {"type": "string"},
                      "why": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
