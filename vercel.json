{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "web",
  "cleanUrls": false,
  "functions": {
    "api/index.py": {
      "includeFiles": "{content/topics/*/topic.json,content/topics/*/tables/*.json,schemas/*.json}",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {"source": "/api/(.*)", "destination": "/api/index"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"}
      ]
    },
    {
      "source": "/data/topics/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    },
    {
      "source": "/data/manifest.json",
      "headers": [{"key": "Cache-Control", "value": "no-cache"}]
    },
    {
      "source": "/config.json",
      "headers": [{"key": "Cache-Control", "value": "no-cache"}]
    },
    {
      "source": "/(js|css)/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]
    }
  ]
}
